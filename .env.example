# Copy to `.env` and fill in from your Supabase project settings.
# These same three are the repository secrets CI needs for its database tier
# (.github/workflows/ci.yml) -- point those at a SCRATCH project, since the
# integration suites write real rows.

# Postgres connection string. Use the POOLED connection (port 6543); lib/db
# sets `prepare: false` because that port runs PgBouncer in transaction mode.
# Used by: drizzle-kit (db:migrate), scripts/seed.ts, every server query, and
# the opt-in DB test suites.
DATABASE_URL=

# The site's own public origin, e.g. https://driverpit.com -- no trailing slash
# (one is stripped anyway). Everything SEO reads it: metadataBase, every
# canonical URL, the sitemap, robots.txt and the OG card. Optional locally and in
# preview, where it falls back to Vercel's own production domain and then to
# localhost:3000; SET IT IN PRODUCTION. A missing value there means every
# canonical on the site points at a Vercel subdomain instead of the real one, and
# nothing errors -- the pages render, the tags are simply wrong. See lib/seo/site.ts.
NEXT_PUBLIC_SITE_URL=

# Which deployed origin `npm run seo:audit` reads back (scripts/seoAudit.ts).
# Optional: it falls back to NEXT_PUBLIC_SITE_URL above, and refuses to run if
# neither is set rather than defaulting to localhost -- an audit that quietly
# retargets itself reports green about the wrong site. Set it only to audit
# something other than the configured origin (a preview deployment, say).
SEO_AUDIT_URL=

# Project URL + public anon key -- Supabase Dashboard → Project Settings → API.
# Public by design (they ship in the client bundle); every visitor holds them,
# which is why access control lives in RLS and in EXECUTE grants, not in secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which F1DB release scripts/seed.ts reads. NO DEFAULT, deliberately: the seed
# UPDATEs 792 live driver rows in place, so which release it reads is a choice,
# and it refuses to run without this rather than picking one for you. A tag pins
# it (see https://github.com/f1db/f1db/releases); `latest` follows upstream and
# says so in the log, accepting that a column rename lands unannounced -- that
# is what the weekly roster-refresh workflow uses, backed by the header
# assertions and canaries in scripts/releaseGuards.ts.
# Needed only to run the seed; nothing else reads it.
F1DB_RELEASE=v2026.11.0

# AdSense. Both are optional: until both are set, components/ads renders a
# neutral placeholder (getAdsenseUnit() is the single "are real ads on?"
# check). NEXT_PUBLIC_ADSENSE_SLOT only exists after AdSense approval.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
